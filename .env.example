# Copy to .env and edit.
# Host network mode: nginx binds directly on the host (no port mapping).
# Use 127.0.0.1 to allow only a local reverse proxy.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# php-fpm listens on 127.0.0.1:<port> on the host. Change if 9000 is taken.
PHP_FPM_PORT=9000
APP_TZ=Europe/Vilnius
# Shown in report subject/footer. Empty = container hostname.
APP_HOSTNAME=

# Web UI login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
# Optional bcrypt hash (php -r 'echo password_hash("pass", PASSWORD_DEFAULT);'). Overrides ADMIN_PASSWORD. Escape $ as $$ in .env.
ADMIN_PASSWORD_HASH=

# Host dir with Postfix logs, mounted read-only at /hostlog
MAIL_LOG_DIR=/var/log
# Files read inside the container (current + rotated, .gz supported)
MAIL_LOG_GLOB=/hostlog/mail.log*
# GID of host group that can read mail.log (Debian: adm = 4). Check: stat -c %g /var/log/mail.log
LOG_GID=4

# Initial SMTP defaults for reports (editable later in Settings).
# Host network: 127.0.0.1 is the Postfix on the Docker host.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
# none | starttls | ssl
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
